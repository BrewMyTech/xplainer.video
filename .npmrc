# NOTE: pnpm 11 no longer reads pnpm-specific settings from .npmrc. Every
# setting below is mirrored in pnpm-workspace.yaml (nodeLinker,
# injectWorkspacePackages, engineStrict), which is the copy pnpm 11 actually
# obeys. This file is kept because npm, npx and older pnpm still read it, and
# because the settings are part of the recorded decision. Change both together.

# electron-builder resolves and packs the production dependency tree by walking
# real directories; pnpm's default symlinked store is a known failure mode for
# it. Hoisting trades pnpm's strict dependency isolation for a node_modules
# layout electron-builder can traverse. Recorded in ADR 0004's Consequences.
node-linker=hoisted

# node-linker=hoisted flattens EXTERNAL packages only; pnpm keeps WORKSPACE
# dependencies as symlinks whatever the linker setting. apps/desktop takes
# @xplainer/cli as a production dependency, so without injection
# electron-builder is handed a symlink it will not follow. Injection makes pnpm
# hard-copy the workspace package into apps/desktop/node_modules/ instead.
# Consequence: an injected workspace package is copied at install time, so a
# rebuilt apps/cli reaches apps/desktop only after `pnpm install` runs again.
inject-workspace-packages=true

# pnpm dedupes an injected dependency back to a plain symlink when the injected
# copy would be identical to the source, which undoes the setting above. Turning
# the dedupe off is what makes injection actually materialise a directory.
dedupe-injected-deps=false

# An injected copy is hard-copied at install time, so a member's freshly built
# dist/ would not reach its dependents until the next install. This re-syncs
# every injected copy right after that package's build script runs.
#
# IT DOES NOT PICK UP A NEW FILE. Measured on pnpm 11.25.0, 2026-09-11: a
# rebuild propagates edits to files that existed at install time, because those
# are hardlinked into the copy and written through — but a file the build
# creates for the first time never appears, and neither `pnpm install` nor
# `pnpm install --force` adds it, both answering "Already up to date". The
# injected copy of @xplainer/cli was missing dist/install/materialise.js and
# dist/runtime/template.js, 110 of 112 files, while every consumer resolved it.
#
# It is silent until an EXISTING file starts importing a new one: the edit
# propagates, the import target does not, and apps/desktop fails to load
# @xplainer/cli with "Cannot find module .../dist/runtime/template.js" — in a
# test that never mentions the new module. So after adding a file to an injected
# package, re-materialise the copy rather than trusting this setting:
#
#   rm -rf node_modules/.pnpm/@xplainer+cli@file+apps+cli_*/node_modules/@xplainer/cli
#   pnpm install --force        # and check it came back: pnpm may no-op
#
# CI is unaffected: there dist/ does not exist at install time, so the copy is
# materialised from the build with every file present.
sync-injected-deps-after-scripts[]=build

# Makes the Node 24 pin in "engines" a hard failure rather than a warning.
engine-strict=true
