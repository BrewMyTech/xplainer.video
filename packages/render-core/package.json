{
  "name": "@xplainer/render-core",
  "version": "0.0.2",
  "type": "module",
  "description": "Remotion workspace template, the ownership-aware video scaffold generator (engine-owned composition shell, agent-owned scenes) and the render preflight.",
  "homepage": "https://xplainer.video",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrewMyTech/xplainer.video.git",
    "directory": "packages/render-core"
  },
  "author": "Rishav Anand <rishav@brewmytech.com>",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "xplainer": {
    "tier": "open-later"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./template/*": "./template/*"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/scaffold/templates/*.txt",
    "dist/g2p/data/*",
    "template",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-templates.mjs && node scripts/copy-g2p-data.mjs && xplainer-minify-dist",
    "prepack": "xplainer-sync-license",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@xplainer/protocol": "workspace:*",
    "@xplainer/tts-client": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@xplainer/config": "workspace:*",
    "ajv": "8.20.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
