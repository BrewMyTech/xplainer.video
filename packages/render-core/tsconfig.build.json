{
  "extends": "@xplainer/config/tsconfig/node.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "removeComments": false,
    "isolatedDeclarations": true
  },
  "include": ["src"],
  "exclude": ["dist", "template", "test/fixtures", "src/scaffold/templates", "src/**/*.test.ts"]
}
