{
  "name": "@xplainer/mcp-server",
  "version": "0.0.0",
  "type": "module",
  "description": "Backend-agnostic MCP tool registration for the eight explainer tools, shared by every TypeScript surface that serves the protocol.",
  "homepage": "https://xplainer.video",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrewMyTech/xplainer.video.git",
    "directory": "packages/mcp-server"
  },
  "author": "Rishav Anand <rishav@brewmytech.com>",
  "license": "Apache-2.0",
  "xplainer": {
    "tier": "open-later"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && xplainer-minify-dist",
    "prepack": "xplainer-sync-license",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@xplainer/protocol": "workspace:*",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@xplainer/config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
