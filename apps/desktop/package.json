{
  "name": "@xplainer/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Optional Electron client for the xplainer CLI daemon (open-later tier).",
  "author": {
    "name": "Rishav Anand",
    "email": "rishav@brewmytech.com"
  },
  "homepage": "https://xplainer.video",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "xplainer": {
    "tier": "open-later"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --publish never",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@xplainer/cli": "workspace:*",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "@xplainer/config": "workspace:*",
    "cross-env": "10.1.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "catalog:",
    "vite": "7.3.6",
    "vitest": "catalog:"
  }
}
