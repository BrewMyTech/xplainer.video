{
  "name": "@xplainer/cli",
  "version": "0.0.1",
  "type": "module",
  "description": "The xplainer local runtime: the `xplainer` binary, its always-on daemon, and the HTTP and MCP server core they serve.",
  "homepage": "https://xplainer.video",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrewMyTech/xplainer.video.git",
    "directory": "apps/cli"
  },
  "author": "Rishav Anand <rishav@brewmytech.com>",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "xplainer": {
    "tier": "open-later"
  },
  "bin": {
    "xplainer": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && xplainer-minify-dist",
    "prepack": "xplainer-sync-license",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@xplainer/mcp-server": "workspace:*",
    "@xplainer/protocol": "workspace:*",
    "@xplainer/render-core": "workspace:*",
    "@xplainer/tts-client": "workspace:*",
    "commander": "15.0.0",
    "hono": "4.13.5"
  },
  "devDependencies": {
    "@remotion/captions": "4.0.495",
    "@remotion/cli": "4.0.495",
    "@remotion/media": "4.0.495",
    "@remotion/tailwind-v4": "4.0.495",
    "@types/node": "catalog:",
    "@xplainer/config": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.495",
    "smol-toml": "1.8.0",
    "tailwindcss": "4.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
