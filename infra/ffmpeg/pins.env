# Every input of the macOS FFmpeg build, pinned. Sourced by the scripts beside
# it and hashed into the workflow's cache key, so a change here is a new build.
#
# Plain KEY=value lines with literal values only — no expansion, no quoting —
# so that the same file is valid shell and a valid dotenv.
#
# Changing ANY pin below other than XP_BUILD_VERSION's own suffix means bumping
# XP_BUILD_VERSION too: a published directory on cdn.xplainer.video is
# immutable, and publish.sh refuses to overwrite an object whose bytes differ.
# The first build of FFmpeg 9.0.2 is `9.0.2`; a rebuild with a new x264 or zlib
# is `9.0.2-2`, then `9.0.2-3`.

# The directory under toolchain/v1/ffmpeg/ on the CDN, and the version in every
# artefact name.
XP_BUILD_VERSION=9.0.2

# Where a build is published: <XP_CDN_BASE>/<XP_BUILD_VERSION>/ holds the zips,
# and <XP_CDN_BASE>/<XP_BUILD_VERSION>/source/ the complete corresponding source.
# Not a pin, but every artefact names it, so it lives with the pins.
XP_CDN_BASE=https://cdn.xplainer.video/toolchain/v1/ffmpeg

# The licence of this directory and of .github/workflows/ffmpeg-macos.yml, which
# are part of the binary's corresponding source ("the scripts used to control
# compilation and installation", GPLv2 §3) and are published in source/. The
# root LICENSE makes infra/ proprietary, which a published GPL source bundle
# cannot be, so this is the owner's decision to record here and in LICENSE.
# publish.sh refuses to publish while it is UNDECIDED.
XP_SCRIPTS_LICENCE=UNDECIDED

# FFmpeg release tarball from ffmpeg.org, with its detached signature. The
# signature is checked against keys/ffmpeg-release.asc, whose primary key must
# have the fingerprint below.
FFMPEG_VERSION=9.0.2
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz
FFMPEG_SHA256=8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e
FFMPEG_ASC_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz.asc
FFMPEG_ASC_SHA256=d617fd94ea354dadd2a8bb16243d37c44e1e9729b06b6ad58fe30bfb0fa943f2
FFMPEG_KEY_FPR=FCF986EA15E6E293A5644F10B4322F04D67658D8

# x264 at a named commit of its `stable` branch, as the archive code.videolan.org
# generates for that commit. Resolved 2026-11-11: the head of `stable`
# ("i8mm & neon hpel_filter optimization", 2025-06-08).
X264_COMMIT=b35605ace3ddf7c1a5d67a2eb553f034aef41d55
X264_URL=https://code.videolan.org/videolan/x264/-/archive/b35605ace3ddf7c1a5d67a2eb553f034aef41d55/x264-b35605ace3ddf7c1a5d67a2eb553f034aef41d55.tar.bz2
X264_SHA256=6eeb82934e69fd51e043bd8c5b0d152839638d1ce7aa4eea65a3fedcf83ff224

# zlib release tarball from the project's GitHub release, which unlike zlib.net
# keeps old versions at a stable URL. 1.3.2 rather than 1.4: on 2026-11-11 1.4
# was six days old, and its one security fix is in contrib/, which is not built.
ZLIB_VERSION=1.3.2
ZLIB_URL=https://github.com/madler/zlib/releases/download/v1.3.2/zlib-1.3.2.tar.gz
ZLIB_SHA256=bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16
ZLIB_ASC_URL=https://github.com/madler/zlib/releases/download/v1.3.2/zlib-1.3.2.tar.gz.asc
ZLIB_ASC_SHA256=977472e4d306906adbe34f8b1fdbf58c46fe8b4ade1c92117816b8281c5ee096
ZLIB_KEY_FPR=5ED46A6721D365587791E2AA783FCD8E58BCAFBA

# nasm is a build tool for the x86-64 assembly in x264 and FFmpeg. It is built
# from source for the x64 target only and never ends up in an artefact.
NASM_VERSION=3.02
NASM_URL=https://www.nasm.us/pub/nasm/releasebuilds/3.02/nasm-3.02.tar.xz
NASM_SHA256=87336eba53b4acfe917424ab5d500d2b0054d9f5148d35c2273ccf2cfb712f0d

# The oldest macOS the binary runs on, for both architectures.
MACOS_MIN=12.0

# The toolchain the workflow builds with, asserted rather than assumed. Present
# on both the `macos-15` (arm64) and `macos-15-intel` images as of 2026-11-04.
XCODE_VERSION=26.3
XCODE_BUILD=17C529

# The modification time of every entry in an artefact zip, so that two builds of
# the same binary produce the same zip. The FFmpeg 9.0.2 release date, UTC.
ZIP_MTIME=202609180000
