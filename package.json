{
  "name": "xplainer-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "xplainer.video \u2014 agent-driven explainer video monorepo",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo build lint typecheck test",
    "verify": "pnpm turbo build lint typecheck test && pnpm biome check . && pnpm check:no-suppressions && pnpm lint:tiers && pnpm check:publish-contract && pnpm check:codegen-fresh && pnpm check:api-report && pnpm check:docs-contract",
    "codegen": "turbo codegen",
    "lint:tiers": "node packages/config/bin/check-tiers.mjs",
    "check:no-suppressions": "node scripts/check-no-suppressions.mjs",
    "check:codegen-fresh": "pnpm --filter @xplainer/protocol codegen:check",
    "check:publish-contract": "node scripts/check-publish-contract.mjs",
    "api:report": "node scripts/api-report.mjs",
    "check:api-report": "node scripts/api-report.mjs --check",
    "check:docs-contract": "node scripts/check-docs-contract.mjs",
    "e2e:render": "node scripts/e2e/render.mjs",
    "e2e:speech": "node scripts/e2e/speech.mjs",
    "e2e:runtime": "node scripts/e2e/runtime.mjs",
    "e2e:toolchain": "node scripts/e2e/toolchain.mjs",
    "e2e:update": "node scripts/e2e/update.mjs",
    "e2e:identity": "node scripts/e2e/identity.mjs",
    "e2e:remote": "node scripts/e2e/remote.mjs",
    "e2e:render:linux": "node scripts/e2e/linux.mjs",
    "e2e:macos": "node scripts/e2e/render.mjs",
    "relink:cli": "node scripts/relink-injected-cli.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@changesets/cli": "3.0.2",
    "lefthook": "2.1.12",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
